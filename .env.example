# --- Phase 0 decisions (see CLAUDE.md section 2) ---
CROP=paddy
REGION=
LANGUAGE_CODE=te
LANGUAGE_NAME=Telugu
# Confirm with your local extension office before going live.
EXPERT_CONTACT=Kisan Call Centre: 1800-180-1551 (toll free)

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- RAG ---
# Minimum cosine similarity (0-1) for a source chunk to count as support.
MIN_SOURCE_SIMILARITY=0.35
RETRIEVAL_TOP_K=6

# --- Telegram (early testing) ---
TELEGRAM_BOT_TOKEN=
# Any random string; sent by Telegram on webhook calls.
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# --- Speech (provider not chosen yet: "none" replies asking the farmer to type) ---
SPEECH_PROVIDER=none

# --- Storage / privacy ---
DB_PATH=data/app.db
# Random secret used to hash user ids in logs. Never change it after go-live.
USER_ID_SALT=change-me
